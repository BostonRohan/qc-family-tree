---
interface Props {
  title: string;
  subtitle?: string;
  containerClass?: string;
  titleClass?: string;
  subtitleClass?: string;
}

const {
  title,
  subtitle,
  containerClass = "text-center",
  titleClass = "mb-1 sm:mb-3 text-3xl sm:text-4xl lg:text-5xl font-bold font-ubuntu",
  subtitleClass =
    "text-muted-foreground max-w-2xl mx-auto whitespace-pre-line leading-relaxed",
} = Astro.props;
---

<hgroup class={`${containerClass}`}>
  <h1 class={`${titleClass}`}>{title}</h1>
  {subtitle && (
    <p class={`${subtitleClass}`}>
      {subtitle}
    </p>
  )}
</hgroup>
