---
import { BANNER_QUERY } from "@/utils/banner";
import { sanityClient } from "sanity:client";
import { type Banner } from "sanity.types";
import { FileText } from "lucide-react";

const banner = await sanityClient
  .fetch<Banner | null>(BANNER_QUERY, {}, { perspective: "published" })
  .catch((error: unknown) => {
    console.error("Error fetching banner:", error);
  });
---

{
  banner?.showBanner && (
    <div class="bg-secondary/20 flex justify-center items-center w-full h-12 gap-4 px-4 mt-16">
      <div class="flex items-center gap-2">
        <FileText className="size-4 text-secondary/70 flex-shrink-0" aria-hidden="true" />
        <p class="text-muted-foreground sm:text-base text-sm">{banner.title}</p>
      </div>
      <a
        class="sm:text-base text-sm text-secondary underline"
        href={banner.primaryCtaLink}
      >
        {banner.primaryCtaLabel}
      </a>
    </div>
  )
}
