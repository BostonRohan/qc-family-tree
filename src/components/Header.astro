---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Link } from "@/components/ui/link";
import logoImage from "@/assets/logo-fullcolor-white-tag.png";
import defaultHeaderImage from "@/assets/homepage-header.jpg";

interface CTA {
  label: string;
  href: string;
  target?: string;
  rel?: string;
}

interface Props {
  title: string;
  tagline?: string;
  subline?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
  className?: string;
  imageClassName?: string;
  logoClassName?: string;
  overlayClassName?: string;
}

const {
  title,
  tagline,
  subline,
  image = defaultHeaderImage,
  imageAlt = "",
  primaryCta,
  secondaryCta,
  className = "",
  imageClassName = "",
  logoClassName = "",
  overlayClassName = "bg-black/30",
} = Astro.props as Props;
---

<section
  id="hero"
  data-hero-section
  class={`relative flex min-h-[560px] w-full items-center overflow-hidden py-28 sm:py-32 lg:py-40 ${className}`}
>
  <Image
    src={image}
    width={1200}
    height={650}
    sizes="100vw"
    alt={imageAlt}
    fetchpriority="high"
    class={`absolute inset-0 w-full h-full object-cover ${imageClassName}`}
  />
  <div class={`absolute inset-0 ${overlayClassName}`}></div>
  <div class="site-container relative z-10">
    <div class="max-w-4xl">
      <div class="flex flex-col items-center gap-6 text-center lg:items-start lg:text-left">
        <Image
          width={128}
          height={128}
          format="png"
          src={logoImage}
          alt="QC Family Tree"
          loading="eager"
          fetchpriority="high"
          class={`h-24 w-24 drop-shadow-lg sm:h-28 sm:w-28 ${logoClassName}`}
        />
        <h1 class="text-balance text-5xl leading-[0.95] tracking-tight text-white drop-shadow-lg sm:text-6xl lg:text-7xl">
          {title}
        </h1>
        {tagline && <p class="font-ubuntu text-xl font-bold text-secondary drop-shadow-lg sm:text-2xl">{tagline}</p>}
        {subline && <p class="max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">{subline}</p>}
        {(primaryCta || secondaryCta) && (
          <div class="flex flex-wrap justify-center gap-3 lg:justify-start">
            {primaryCta && (
              <Link
                size="lg"
                className="rounded-2xl px-8"
                href={primaryCta.href}
                target={primaryCta.target}
                rel={primaryCta.rel}
              >
                {primaryCta.label}
              </Link>
            )}
            {secondaryCta && (
              <Link
                size="lg"
                variant="outline"
                className="rounded-2xl px-8"
                href={secondaryCta.href}
                target={secondaryCta.target}
                rel={secondaryCta.rel}
              >
                {secondaryCta.label}
              </Link>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
