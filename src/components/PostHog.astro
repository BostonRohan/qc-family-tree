<script>
  import posthog from "posthog-js";

  const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
  const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

  if (import.meta.env.PROD && apiKey) {
    posthog.init(apiKey, {
      api_host: apiHost,
      defaults: "2026-05-30",
      autocapture: true,
      capture_pageview: true,
      capture_pageleave: true,
      session_recording: {
        maskAllInputs: true,
      },
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      const element = target?.closest("a, button");

      if (!element) return;

      const link = element instanceof HTMLAnchorElement ? element : null;
      const text = element.textContent?.replace(/\s+/g, " ").trim().slice(0, 120);

      posthog.capture("site_element_clicked", {
        element_type: link ? "link" : "button",
        element_text: text || undefined,
        href: link?.href,
        external: link ? link.origin !== window.location.origin : undefined,
      });
    });

    document.addEventListener("submit", (event) => {
      const form = event.target;

      if (!(form instanceof HTMLFormElement)) return;

      posthog.capture("site_form_submitted", {
        form_id: form.id || undefined,
        form_name: form.getAttribute("name") || undefined,
        form_action: form.getAttribute("action") || window.location.pathname,
      });
    });
  }
</script>
