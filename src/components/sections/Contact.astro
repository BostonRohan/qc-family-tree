---
import { phoneNumber, emailAddress } from "@constants";
import { Phone, Mail, Clock, MapPin } from "@lucide/astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

const h3Class = "sm:text-xl text-lg mb-1 font-semibold";
const iconClass = "sm:w-6 sm:h-6 w-4 h-4";
---

<section id="contact" class="site-section bg-secondary/20">
  <div class="site-container">
    <div class="flex flex-col gap-12">
      <SectionHeading
        title="Get In Touch"
        headingLevel="h1"
        subtitle={`Have a question or want to work together? We'd love to hear from you.
Reach out to us using any of the methods below.`}
      />

      <div class="mx-auto max-w-4xl">
        {/* Contact Information */}
        <div class="space-y-8">
          <div class="surface-card border-t-4 border-t-accent p-6 sm:p-8">
          <h2 class="sm:text-3xl font-semibold text-xl mb-6">
            Contact Information
          </h2>

          <div class="space-y-6">
            {/* Phone */}
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-secondary/20"
              >
                <Phone class={`text-primary ${iconClass}`} />
              </div>
              <div>
                <h3 class={h3Class}>Phone</h3>
                <a
                  href={`tel:${phoneNumber}`}
                  class="text-primary hover:underline"
                >
                  {phoneNumber}
                </a>
              </div>
            </div>

            {/* Email */}
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-secondary/20"
              >
                <Mail class={`text-primary ${iconClass}`} />
              </div>
              <div>
                <h3 class={h3Class}>Email</h3>
                <a
                  href={`mailto:${emailAddress}`}
                  class="text-primary hover:underline"
                >
                  {emailAddress}
                </a>
              </div>
            </div>

            {/* Address */}
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-secondary/20"
              >
                <MapPin class={`text-primary ${iconClass}`} />
              </div>
              <div>
                <h3 class={h3Class}>Address</h3>
                <div class="flex flex-wrap gap-4">
                  <div>
                    <h4 class="font-medium">Mailing Address</h4>
                    <p class="text-muted-foreground">
                      2910 Parkway Avenue<br />
                      Charlotte, North Carolina 28208
                    </p>
                  </div>
                  <div>
                    <h4 class="font-medium">Physical Address</h4>
                    <p class="text-muted-foreground">
                      2916 Parkway Avenue<br />
                      Charlotte, North Carolina 28208
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
