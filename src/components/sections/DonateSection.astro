---
import { Link } from '@/components/ui/link';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import homeDonateImage from '@/assets/home-donate.jpeg';
---

<section id="freedom-fridge" class="relative overflow-hidden py-8 lg:py-16 px-4 text-white">
  <div class="pointer-events-none absolute inset-0">
    <img
      src={homeDonateImage.src}
      alt="QC Family Tree donation event"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/40 to-slate-950/65" aria-hidden="true" />

  <div class="relative mx-auto max-w-5xl space-y-10 z-10 text-center">
    <div class="space-y-6 sm:space-y-8">
      <SectionHeading
        title="Invest in Community"
        subtitle="Your contribution keeps food, cultural programs, and mutual aid flowing through Charlotte."
        titleClass="text-white mb-1 sm:mb-3 text-3xl sm:text-4xl lg:text-5xl font-bold font-ubuntu"
        subtitleClass="text-white/80"
      />
      <p class="max-w-3xl px-2 mx-auto text-white/90">
        QCFT sustains affordable housing, cultural organizing, educational programming, and the <a href="/freedom-fridge" class="underline hover:text-white">Freedom Fridge</a> & Pantry. Gifts of any size ripple through the neighborhood and keep the community grounded in collective care.
      </p>
    </div>
    <div class="flex justify-center">
      <Link
        href="https://www.paypal.com/donate?hosted_button_id=5CZWHCA4YRQLW"
        variant="secondary"
        className="rounded-xl px-6 py-4 text-base min-w-[220px] text-center"
      >
        Donate
      </Link>
    </div>
  </div>
</section>
