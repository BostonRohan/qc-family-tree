---
import { Link } from '@/components/ui/link';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import homeDonateImage from '@/assets/home-donate.jpeg';
---

<section id="freedom-fridge" class="relative overflow-hidden py-16 px-4 text-white">
  <div class="pointer-events-none absolute inset-0">
    <img
      src={homeDonateImage.src}
      alt="QC Family Tree donation event"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/40 to-slate-950/65" aria-hidden="true" />

  <div class="relative mx-auto max-w-5xl space-y-10 z-10 text-center">
    <div class="space-y-6 sm:space-y-8">
      <SectionHeading
        title="Support the Freedom Fridge"
        subtitle="Your contribution keeps food, cultural programs, and mutual aid flowing through Charlotte."
        titleClass="mb-1 sm:mb-3 sm:text-5xl text-[24px] font-bold font-ubuntu text-white"
        subtitleClass="text-slate-200 max-w-2xl mx-auto whitespace-pre-line leading-relaxed sm:text-[18px] text-[16px]"
      />
      <p class="max-w-3xl text-slate-100 px-2 text-center mx-auto">
        QCFT sustains affordable housing, cultural organizing, community education, and
        the Freedom Fridge & Pantry. Gifts of any size ripple through the neighborhood and
        keep our campus rooted in collective care.
      </p>
    </div>
    <div class="flex justify-center">
      <Link
        href="/freedom-fridge"
        variant="secondary"
        className="rounded-xl px-6 py-4 text-base min-w-[220px] text-center"
      >
        Give now
      </Link>
    </div>
  </div>
</section>
