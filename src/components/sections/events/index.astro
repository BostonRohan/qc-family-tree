---
import {
  LayoutList,
  Calendar as CalendarIcon,
  MapPin,
  Search,
  Filter,
  Plus,
} from "lucide-react";
import EventListView from "./list/index.astro";
// import EventCalendarView from "../components/EventCalendarView.astro";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { getUpcomingEvents } from "@/lib/calendar";

interface Props {
  includeFilters?: boolean;
  maxDays?: number;
  maxResults?: number;
}

const { includeFilters, maxDays, maxResults } = Astro.props;

const events = await getUpcomingEvents({ maxDays, maxResults });
---

<div>
  {
    includeFilters && (
      <div class="flex flex-wrap items-center gap-3">
        <div class="bg-muted p-1 rounded-xl flex" id="view-toggle">
          <button
            data-view="list"
            class="view-btn active flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all"
          >
            <LayoutList className="w-4 h-4" />
            List View
          </button>
          <button
            data-view="grid"
            class="view-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all"
          >
            <CalendarIcon className="w-4 h-4" />
            Grid View
          </button>
        </div>
      </div>
    )
  }
</div>

<!-- Main Content -->
<main class="max-w-6xl mx-auto pt-4 pb-12">
  <header class="mx-auto max-w-5xl px-4 mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
    <div class="flex-1">
      <SectionHeading
        title="Upcoming Events"
        subtitle="Join us at our next community gathering"
        containerClass="text-left"
        subtitleClass="text-muted-foreground whitespace-pre-line leading-relaxed"
      />
    </div>
    <a
      href="/#events"
      class="text-sm font-semibold text-primary hover:text-primary/80 underline"
    >
      View all events
    </a>
  </header>
  <!-- Toolbar -->
  <div
    class="px-4 mb-4 flex flex-col md:flex-row gap-4 items-center justify-between"
  >
    {
      includeFilters && (
        <>
          <div class="relative w-full md:w-96">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
            <input
              type="text"
              placeholder="Search events, locations..."
              id="search-input"
              class="w-full pl-10 pr-4 py-2 bg-background border border-input rounded-xl focus:outline-none focus:ring-2 focus:ring-ring/20 focus:border-ring transition-all text-sm"
            />
          </div>
          <div class="flex gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0">
            <Badge variant="outline">All</Badge>
            <Badge variant="secondary">Workshops</Badge>
            <Badge variant="secondary">Meetings</Badge>
            <Badge variant="secondary">Social</Badge>
            <button class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground px-2 py-1 transition-colors">
              <Filter className="w-3 h-3" />
              More Filters
            </button>
          </div>
        </>
      )
    }
  </div>

  <!-- View Switcher Content -->
  <div id="list-view">
    <EventListView events={events} />
  </div>
  <div id="grid-view" class="hidden">
    <!-- <EventCalendarView events={MOCK_EVENTS} /> -->
    event calendar view
  </div>
</main>

<script>
  // View toggle functionality
  const viewButtons = document.querySelectorAll(".view-btn");
  const listView = document.getElementById("list-view");
  const gridView = document.getElementById("grid-view");

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const view = button.getAttribute("data-view");

      // Update button states
      viewButtons.forEach((btn) => {
        if (btn.getAttribute("data-view") === view) {
          btn.classList.add("active", "bg-background", "text-primary", "shadow-sm");
          btn.classList.remove("text-muted-foreground", "hover:text-foreground");
        } else {
          btn.classList.remove(
            "active",
            "bg-background",
            "text-primary",
            "shadow-sm",
          );
          btn.classList.add("text-muted-foreground", "hover:text-foreground");
        }
      });

      // Toggle views
      if (view === "list") {
        listView?.classList.remove("hidden");
        gridView?.classList.add("hidden");
      } else {
        listView?.classList.add("hidden");
        gridView?.classList.remove("hidden");
      }
    });
  });

  // Search functionality (basic client-side filter)
  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement;
  searchInput?.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    // You'll implement the actual filtering in your EventListView component
    console.log("Search query:", query);
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
