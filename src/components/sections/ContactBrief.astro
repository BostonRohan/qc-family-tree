---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { Link } from '@/components/ui/link';
import { phoneNumber, emailAddress } from '@constants';
---

<section id="contact" class="px-4">
  <div class="mx-auto max-w-5xl rounded-3xl border border-slate-200 bg-white/80 p-8 shadow-lg">
    <SectionHeading
      title="Stay connected"
      subtitle="Questions, ideas, and offers of help are welcome."
    />
    <div class="mt-6 flex flex-col gap-6 text-slate-700 sm:flex-row sm:justify-center sm:gap-12">
      <div>
        <p class="font-semibold">Phone</p>
        <a href={`tel:${phoneNumber}`} class="text-primary">{phoneNumber}</a>
      </div>
      <div>
        <p class="font-semibold">Email</p>
        <a href={`mailto:${emailAddress}`} class="text-primary">{emailAddress}</a>
      </div>
      <div>
        <p class="font-semibold">Visit</p>
        <p>2916 Parkway Avenue, Charlotte, NC</p>
      </div>
    </div>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
      <Link href="/about" variant="secondary" className="rounded-xl px-6 py-3">
        Learn more about QCFT
      </Link>
      <Link href="/contact" variant="ghost" className="text-sm">
        Contact us directly →
      </Link>
    </div>
    <div class="mt-8 flex flex-col items-center gap-4 border-t border-slate-200 pt-8">
      <form
        id="homepage-subscribe-form"
        class="flex flex-col gap-2 sm:flex-row sm:items-center"
      >
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          required
          class="rounded-xl border border-slate-200 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20"
        />
        <button
          type="submit"
          class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary/90"
        >
          Subscribe
        </button>
      </form>
      <p class="text-xs text-slate-500">Get QCFT updates, event announcements, and opportunities.</p>
      <p class="text-xs text-slate-500" id="homepage-form-message"></p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("homepage-subscribe-form");
  const messageEl = document.getElementById("homepage-form-message");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form as HTMLFormElement);
    const email = formData.get("email");

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, list: "qcft" }),
      });

      if (res.ok) {
        messageEl!.textContent = "Thanks for subscribing!";
        (form as HTMLFormElement).reset();
      } else {
        const data = await res.json();
        messageEl!.textContent = data.message || "Something went wrong. Try again.";
      }
    } catch {
      messageEl!.textContent = "Something went wrong. Try again.";
    }
  });
</script>
