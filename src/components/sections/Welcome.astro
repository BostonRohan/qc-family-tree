---
import { Image } from "astro:assets";
import headerImage from "@/assets/homepage-header.jpg";
import logoImage from "@/assets/logo-fullcolor-white-tag.png";
---

<section
  id="hero"
  data-hero-section
  class="w-full relative min-h-[650px] flex items-center justify-center overflow-hidden"
>
  <Image
    src={headerImage}
    sizes="100vw"
    alt="QC Family Tree community"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-black/30"></div>
  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center lg:items-start lg:flex-row lg:gap-12 gap-8">
      <div class="flex flex-col items-center lg:items-start gap-6 lg:gap-8">
        <Image
          width={180}
          height={180}
          format="png"
          src={logoImage}
          alt="QC Family Tree"
          fetchpriority="high"
          class="w-32 h-32 sm:w-40 sm:h-40 drop-shadow-lg"
        />
        <div>
          <h1 class="flex flex-col font-semibold text-center lg:text-left gap-1 font-ubuntu">
            <span class="text-4xl sm:text-5xl lg:text-6xl text-white drop-shadow-lg">
              Cultivating Community
            </span>
            <span class="text-2xl sm:text-3xl lg:text-4xl text-secondary drop-shadow-lg">
              For The Common Good
            </span>
          </h1>
        </div>
      </div>
    </div>
  </div>
</section>
