---
import { Image } from "astro:assets";
import headerImage from "@/assets/homepage-header.jpg";
import logoImage from "@/assets/logo-fullcolor-white-tag.png";
import { Link } from "@/components/ui/link";
---

<section class="w-full sm:h-[750px] h-[650px] relative max-w-[1280px] mx-auto">
  <div class="relative">
    <Image
      src={headerImage}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="h-[400px] object-cover"
    />
    <div class="absolute bottom-0 w-full h-1/3">
      <div
        class="z-20 w-full flex-col justify-center relative flex items-center p-4"
      >
        <Image
          width={400}
          height={400}
          format="png"
          src={logoImage}
          alt="QC Family Tree"
          fetchpriority="high"
          class="sm:w-[400px] sm:h-[400px] w-[250px] h-[250px]"
        />
        <h1
          class="flex flex-col font-semibold text-center sm:gap-4 font-ubuntu"
        >
          <span class="text-5xl sm:text-6xl leading-tight">Cultivating Community</span>
          <span class="text-5xl sm:text-6xl text-secondary leading-tight"
            >For The Common Good</span
          >
          <span class="text-lg sm:text-xl text-white/70 mt-2 tracking-tight"
            >Housing, cultural organizing, and mutual aid in Charlotte.</span
          >
        </h1>
        <div class="mt-6 flex flex-col sm:flex-row sm:justify-center gap-3">
          <Link
            href="/donate"
            size="lg"
            className="rounded-xl sm:px-10 px-8"
            variant="default"
          >
            Donate
          </Link>
          <Link
            href="/rhizome"
            size="lg"
            className="rounded-xl sm:px-10 px-8"
            variant="outline"
          >
            Join the Rhizome
          </Link>
        </div>
      </div>
      <div
        class="h-full z-10 absolute bottom-0 sm:from-20% from-white bg-linear-to-t to-transparent w-full"
      >
      </div>
    </div>
  </div>
</section>
