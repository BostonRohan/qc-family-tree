---
import { Image } from "astro:assets";
import headerImage from "@/assets/homepage-header.jpg";
import logoImage from "@/assets/logo-fullcolor-white-tag.png";
---

<section class="w-full relative min-h-screen flex items-center justify-center overflow-hidden">
  {/* Full-bleed background image */}
  <Image
    src={headerImage}
    sizes="100vw"
    alt="QC Family Tree community"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover"
  />
  
  {/* Dark overlay for text contrast */}
  <div class="absolute inset-0 bg-black/30"></div>
  
  {/* Content layer */}
  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center lg:items-start lg:flex-row lg:gap-12 gap-8">
      {/* Logo and text on the left */}
      <div class="flex flex-col items-center lg:items-start gap-6 lg:gap-8">
        <Image
          width={180}
          height={180}
          format="png"
          src={logoImage}
          alt="QC Family Tree"
          fetchpriority="high"
          class="w-32 h-32 sm:w-40 sm:h-40 drop-shadow-lg"
        />
        <div>
          <h1 class="flex flex-col font-semibold text-center lg:text-left gap-2 sm:gap-4 font-ubuntu">
            <span class="text-4xl sm:text-5xl lg:text-6xl text-white drop-shadow-lg">
              Cultivating Community
            </span>
            <span class="text-2xl sm:text-3xl lg:text-4xl text-secondary drop-shadow-lg">
              For The Common Good
            </span>
          </h1>
        </div>
      </div>
      
      {/* CTA Button on the right */}
      <div class="flex items-center justify-center lg:justify-start lg:ml-auto">
        <a
          href="#get-involved"
          class="px-8 sm:px-10 py-4 sm:py-5 bg-secondary hover:bg-opacity-90 text-accent font-semibold rounded-lg transition-all duration-300 transform hover:scale-105 drop-shadow-lg font-ubuntu text-lg sm:text-xl"
        >
          Get Involved
        </a>
      </div>
    </div>
  </div>
</section>
