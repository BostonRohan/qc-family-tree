---
import { Megaphone } from "@lucide/astro";
import { Link } from "@/components/ui/link";
import ImageWrapper from "../ImageWrapper.astro";
import type { FeaturedSection } from "sanity.types";

interface Props {
  section?: FeaturedSection | null;
}

const { section } = Astro.props as Props;
const imageAsset = section?.image?.asset as { _id?: string; _ref?: string } | undefined;
const imageId = imageAsset?._id ?? imageAsset?._ref;
---

{
  section && (
    <section
      id="featured"
      class="site-section bg-accent text-accent-foreground"
    >
      <div class="site-container space-y-8">
        <div class="mx-auto w-full max-w-3xl space-y-3">
          <div class="flex gap-4 items-center">
            <h2 class="text-balance text-3xl sm:text-4xl">{section.title}</h2>
            <Megaphone class="text-yellow-500 sm:w-[40px] sm:h-[40px] h-[28px] w-[28px]" />
          </div>
          <p class="opacity-80">{section.description}</p>
          {(section?.primaryCtaLink && section.primaryCtaLabel) ||
            (section?.secondaryCtaLabel && section.secondaryCtaLink) ? (
            <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
              {section?.primaryCtaLink && section.primaryCtaLabel && (
                <Link
                  size="sm"
              className="w-full rounded-xl sm:max-w-[220px]"
                  variant="default"
                  href={section.primaryCtaLink}
                >
                  {section.primaryCtaLabel}
                </Link>
              )}
              {section?.secondaryCtaLabel && section.secondaryCtaLink && (
                <Link
                  size="sm"
                  className="w-full rounded-xl sm:max-w-[220px]"
                  href={section.secondaryCtaLink}
                  variant="outline"
                >
                  {section.secondaryCtaLabel}
                </Link>
              )}
            </div>
          ) : null}
        </div>
        {imageId && (
          <div class="w-full sm:max-w-3xl mx-auto">
            <ImageWrapper
              id={imageId}
              alt={section.title}
              className="h-auto w-full rounded-2xl object-cover"
            />
          </div>
        )}
</div>
    </section>
  )
}
