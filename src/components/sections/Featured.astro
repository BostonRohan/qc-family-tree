---
import { Link } from "@/components/ui/link";
import ImageWrapper from "../ImageWrapper.astro";

interface FeaturedContent {
  title?: string;
  eyebrow?: string;
  dateLine?: string;
  description?: string;
  highlights?: string[];
  image?: { asset?: { _id?: string; _ref?: string } };
  imageAlt?: string;
  primaryCtaLink?: string;
  primaryCtaLabel?: string;
  secondaryCtaLink?: string;
  secondaryCtaLabel?: string;
}

interface Props {
  section?: FeaturedContent | null;
}

const { section } = Astro.props;
const imageAsset = section?.image?.asset;
const imageId = imageAsset?._id ?? imageAsset?._ref;
const primaryCta = section?.primaryCtaLink && section?.primaryCtaLabel;
const secondaryCta = section?.secondaryCtaLink && section?.secondaryCtaLabel;
const isExternalUrl = (url?: string) => /^https?:\/\//i.test(url ?? "");
---

{section && (
  <section id="featured" class="site-section bg-secondary/10">
    <div class="site-container space-y-7 sm:space-y-9">
      {imageId && (
        <div class="mx-auto w-full max-w-4xl">
          <ImageWrapper
            id={imageId}
            alt={section.imageAlt ?? "Community members gathered for a creative activity"}
            className="aspect-[2/1] w-full rounded-2xl object-cover"
          />
        </div>
      )}

      <div class="mx-auto w-full max-w-4xl space-y-5 text-center">
        {section.title && (
          <h2 class="font-ubuntu text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
            {section.title}
          </h2>
        )}

        {(section.dateLine || section.eyebrow) && (
          <div class="flex flex-col items-center justify-center gap-1 sm:flex-row sm:gap-4">
            {section.dateLine && (
              <p class="text-lg font-semibold leading-snug sm:text-xl">{section.dateLine}</p>
            )}
            {section.eyebrow && (
              <p class="text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground">
                {section.eyebrow}
              </p>
            )}
          </div>
        )}

        {section.description && (
          <p class="mx-auto max-w-3xl text-base leading-relaxed text-foreground sm:text-lg">
            {section.description}
          </p>
        )}

        {section.highlights?.length ? (
          <ul class="mx-auto grid max-w-3xl grid-cols-1 gap-x-8 gap-y-3 text-left text-base leading-relaxed sm:grid-cols-2">
            {section.highlights.map((highlight) => (
              <li class="flex items-start gap-3">
                <span
                  aria-hidden="true"
                  class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-secondary"
                ></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        ) : null}

        {(primaryCta || secondaryCta) && (
          <div class="flex flex-col justify-center gap-3 pt-1 sm:flex-row">
            {primaryCta && (
              <Link
                className="w-full rounded-xl px-6 py-4 text-base text-center sm:w-auto sm:min-w-[220px]"
                variant="secondary"
                href={section.primaryCtaLink!}
                target={isExternalUrl(section.primaryCtaLink) ? "_blank" : undefined}
                rel={isExternalUrl(section.primaryCtaLink) ? "noopener noreferrer" : undefined}
              >
                {section.primaryCtaLabel}
              </Link>
            )}
            {secondaryCta && (
              <Link
                size="lg"
                className="w-full rounded-xl border-2 border-secondary/60 bg-background px-6 py-4 text-base text-center shadow-sm hover:bg-secondary/10 hover:text-foreground sm:w-auto sm:min-w-[220px]"
                variant="outline"
                href={section.secondaryCtaLink!}
                target={isExternalUrl(section.secondaryCtaLink) ? "_blank" : undefined}
                rel={isExternalUrl(section.secondaryCtaLink) ? "noopener noreferrer" : undefined}
              >
                {section.secondaryCtaLabel}
              </Link>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}
