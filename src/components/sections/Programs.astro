---
import culturalOrganizingImage from "@/assets/cultural-organizing.jpg";
import cultivateCommunityImage from "@/assets/cultivate-community.jpg";
import featuredProgramsImage from "@/assets/featured-programs.jpg";
import housingJusticeImage from "@/assets/housing-justice.jpg";
import hereForGoodBusinessImage from "@/assets/here-for-good-business.jpg";
import { Briefcase, House, Palette, Users } from "@lucide/astro";

import { DefaultCarousel } from "../ui/carousels/default-carousel";

interface Props {
  sectionId?: string;
  showPillars?: boolean;
  showLearnMore?: boolean;
}

const {
  sectionId = "programs",
  showPillars = true,
  showLearnMore = true,
} = Astro.props as Props;
---

<section id={sectionId} class="px-4 w-full space-y-16">
  <div class="mx-auto w-full max-w-5xl space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-slate-500">How we cultivate community</p>
          <h2 class="sm:text-4xl text-3xl font-ubuntu font-bold">Our programs in action</h2>
        </div>
        {showLearnMore && (
          <a
            href="/about#programs-about"
            class="text-sm font-semibold text-slate-700 hover:text-slate-900 underline"
          >
            Learn more
          </a>
        )}
      </div>
      <DefaultCarousel
        slides={[
          {
            title: "Housing Justice",
            description:
              "Providing affordable units and advocacy with partners like the West Side Community Land Trust keeps neighbors rooted and resilient.",
            image: housingJusticeImage.src,
          },
          {
            title: "Cultural Organizing",
            description:
              "The Rhizome Coalition, Culture Bearer Residency, and public art amplify rooted creativity and call out injustice.",
            image: culturalOrganizingImage.src,
          },
          {
            title: "Community Programming",
            description:
              "Mutual aid, community meals, and neighborhood education programs build trust, belonging, and everyday care.",
            image: cultivateCommunityImage.src,
          },
          {
            title: "Here for Good Business Cooperative",
            description:
              "Co-op services help entrepreneurs, cultural workers, and neighbors imagine a regenerative corridor economy.",
            image: hereForGoodBusinessImage.src,
          },
        ]}
        client:visible
      />
    </div>
  {showPillars && (
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
      {[
        {
          title: "Housing Justice",
          detail: "Stable homes + advocacy that prevent displacement and keep people connected to Enderly Park.",
          icon: House,
        },
        {
          title: "Cultural Organizing",
          detail: "Arts, performances, and the Rhizome keep Black culture and storytelling at the center of the work.",
          icon: Palette,
        },
        {
          title: "Community Programming",
          detail: "Mutual aid pantry, festivals, and education that build practical care networks for everyone.",
          icon: Users,
        },
        {
          title: "Here for Good Business Cooperative",
          detail: "Cooperative business support, training, and shared resources for economic resilience.",
          icon: Briefcase,
        },
      ].map((pillar) => {
        const PillarIcon = pillar.icon;
        return (
          <article class="rounded-2xl border border-slate-200 bg-white/80 p-4 text-sm text-slate-700 shadow-sm">
            <div class="flex items-center gap-2">
              <PillarIcon class="h-5 w-5 text-primary" />
              <h3 class="font-semibold text-slate-900">{pillar.title}</h3>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-slate-600">{pillar.detail}</p>
          </article>
        );
      })}
    </div>
  )}
</section>
