---
import DesktopNav from "@/components/ui/nav/desktop";
import "../styles/global.css";
import MobileNav from "@/components/ui/nav/mobile";
import { Font, Image } from "astro:assets";
import Footer from "@/components/sections/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import Banner from "@/components/banner.astro";
import logoImage from "@/assets/logo-fullcolor-white-tag.png";
import LogoToggle from "@/components/LogoToggle.tsx";

interface Props {
  title: string;
  description: string;
  slug: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  slug,
  ogImage = "/og.jpg",
  ogImageAlt = "People standing outside listening to speaker at a QC Family Tree event",
} = Astro.props;

const navWrapperClassName =
  "fixed inset-x-0 sm:top-4 top-2 w-full z-[100] bg-white/75 backdrop-blur-2xl justify-center max-w-2xl rounded-2xl mx-auto text-center flex";
const isHome = slug === "";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://qcfamilytree.org/${slug}`} />
    <meta property="og:site_name" content="Courtney Rohan" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter or X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@qcfamilytree" />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#b3be35" />

    <link rel="preload" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/ubuntu/v20/uU9eCBsR6Z2vfE9aq3bL0fxyUs4tcw9W-DMn8ACD7j17g.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <Font cssVariable="--font-ubuntu" />

    <title>{title}</title>
  </head>
  <body class="h-full w-full">
    <main class="w-full h-full">
      <Banner />
      <div class="md:block hidden">
        <div class={navWrapperClassName}>
          <div class="relative flex w-full items-center justify-center">
            <a
              href="/"
              class={`hidden h-10 items-center justify-center md:flex absolute left-4 transition-opacity duration-200 ${isHome ? "opacity-0 pointer-events-none" : ""}`}
              aria-label="QC Family Tree home"
              data-nav-logo
            >
              <Image
                src={logoImage}
                alt="QC Family Tree"
                width={60}
                height={60}
                class="h-10 w-auto object-contain"
                fetchpriority="low"
              />
            </a>
            <DesktopNav client:visible />
          </div>
        </div>
      </div>
      <div class="md:hidden block">
        <MobileNav client:visible wrapperClassName={navWrapperClassName} />
      </div>
      {
        import.meta.env.PROD && (
          <>
            <SpeedInsights />
            <Analytics />
          </>
        )
      }
      <slot />
      {isHome && (
        <LogoToggle
          client:load
          heroSelector="[data-hero-section]"
          logoSelector="[data-nav-logo]"
        />
      )}
    </main>
    <Footer />
  </body>
</html>
