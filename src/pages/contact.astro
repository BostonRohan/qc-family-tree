---
import Layout from "@/layouts/Layout.astro";
import ContactSection from "@/components/sections/Contact.astro";
import FollowAlong from "@/components/sections/FollowAlong.astro";
---

<Layout title="Contact" description="Get in touch with QC Family Tree." slug="contact">
  <div class="space-y-8 pb-16 lg:space-y-16 lg:pb-24">
    <ContactSection />
    <div class="px-4">
      <FollowAlong instagramHandle="qcfamilytree" facebookHandle="qcfamilytree" list="qcft" />
    </div>
    <p class="mx-auto max-w-2xl px-4 text-center text-sm text-muted-foreground">
      Want to connect through the work? <a href="/#events" class="text-primary underline hover:text-primary/80">Join an upcoming event</a>, learn about the <a href="/rhizome" class="text-primary underline hover:text-primary/80">Rhizome Coalition</a>, or visit the <a href="/freedom-fridge" class="text-primary underline hover:text-primary/80">Freedom Fridge & Pantry</a>.
    </p>
  </div>
</Layout>
