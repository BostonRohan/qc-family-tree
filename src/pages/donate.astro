---
import Layout from "@/layouts/Layout.astro";
import Accountability from "@/components/sections/Accountability.astro";

const paypalDonateUrl = "https://www.paypal.com/donate";
const paypalHostedButtonId = "5CZWHCA4YRQLW";
const amounts = [25, 50, 100, 250];
---

<Layout title="Give to QC Family Tree" description="Support community care, cultural organizing, affordable housing, and free food access in Charlotte." slug="donate">
  <main data-variate-section="donate-page" class="bg-muted pb-20 pt-28 sm:pt-36">
    <section class="mx-auto max-w-6xl px-4">
      <div class="max-w-3xl">
        <p class="font-ubuntu text-lg text-accent">Give where you live</p>
        <h1 class="mt-5 text-5xl leading-[0.98] tracking-tight sm:text-7xl">Support the work. See how we steward it.</h1>
        <p class="mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl">Your gift helps QC Family Tree cultivate belonging, mutual care, and economic resilience through free food access, cultural programs, and neighborhood-rooted organizing.</p>
      </div>
    </section>

    <section class="mx-auto mt-12 grid max-w-6xl gap-10 px-4 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
      <div class="rounded-3xl bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-3xl">Make a gift</h2>
        <p class="mt-2 text-base text-muted-foreground">Choose an amount, then finish securely with PayPal.</p>
        <div class="mt-6 grid grid-cols-2 rounded-xl bg-muted p-1" role="group" aria-label="Gift frequency">
          <button type="button" aria-pressed="true" class="rounded-lg bg-white px-3 py-2 text-sm font-semibold shadow-sm">One-time</button>
          <button type="button" aria-disabled="true" disabled class="cursor-not-allowed rounded-lg px-3 py-2 text-sm font-semibold text-muted-foreground">Monthly <span class="ml-1 text-xs font-normal">Coming soon</span></button>
        </div>
        <form action={paypalDonateUrl} method="post" target="_top" class="mt-6 space-y-5">
          <input type="hidden" name="hosted_button_id" value={paypalHostedButtonId} />
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {amounts.map((amount) => (
              <label class="cursor-pointer">
                <input class="peer sr-only" type="radio" name="amount" value={amount} checked={amount === 50} />
                <span class="flex justify-center rounded-xl border border-border px-3 py-3 font-ubuntu text-lg peer-checked:border-secondary peer-checked:bg-secondary peer-checked:text-secondary-foreground">${amount}</span>
              </label>
            ))}
          </div>
          <label class="block text-sm font-semibold">Or enter another amount<span class="mt-2 flex rounded-xl bg-muted px-4 text-lg"><span class="py-3">$</span><input name="amount_other" type="number" min="1" placeholder="50" class="w-full bg-transparent px-2 py-3 outline-none" /></span></label>
          <div class="flex items-start gap-3 rounded-2xl border border-border bg-muted/60 p-4">
            <input id="remember-gift" type="checkbox" disabled class="mt-1 h-4 w-4 accent-secondary" />
            <label for="remember-gift" class="text-sm"><span class="font-semibold">Remember this gift for next time</span><span class="mt-1 block font-normal text-muted-foreground">Coming soon. We will remember your amount, never your payment details.</span></label>
          </div>
          <button type="submit" class="w-full rounded-xl bg-accent px-6 py-4 font-ubuntu text-lg font-bold text-accent-foreground">Continue with PayPal</button>
        </form>
      </div>
      <div class="space-y-5">
        <article class="rounded-3xl bg-accent p-6 text-accent-foreground sm:p-8"><h2 class="text-3xl">Why give?</h2><p class="mt-3 leading-relaxed text-accent-foreground/80">We believe thriving communities are built through shared resources, cultural imagination, and sustained mutual care. Your contribution helps keep that practice rooted in Charlotte.</p></article>
        <article class="rounded-3xl border border-border bg-white p-6 sm:p-8"><h2 class="text-2xl">Giving beyond PayPal</h2><ul class="mt-3 space-y-3 text-muted-foreground"><li><span class="font-semibold text-foreground">Checks:</span> contact us for mailing details.</li><li><span class="font-semibold text-foreground">Monthly giving:</span> coming soon online.</li><li><span class="font-semibold text-foreground">Employer matching:</span> ask your workplace how to get started.</li></ul><a href="mailto:info@qcfamilytree.org" class="mt-4 inline-block text-primary underline">info@qcfamilytree.org</a></article>
      </div>
    </section>

    <div class="mx-auto mt-16 max-w-6xl px-4"><Accountability /></div>
  </main>
</Layout>
