---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Header from "@/components/Header.astro";
import { Image } from "astro:assets";
import freedomFridgeImage from "@/assets/freedom_fridge_header.jpg";
import { donateLink } from "@constants";

const waysToHelp = [
  "Donate extra food and supplies to help keep the Freedom Fridge & Pantry stocked for the community.",
  "Shop our Amazon Wishlist to provide fresh ingredients for community meals and special events.",
  "Businesses can safely donate unsold food. Fresh produce, packaged items, and properly handled prepared foods are all welcome.",
  "Make a financial donation to support free food access and community care.",
];
---

<Layout
  title="Freedom Fridge"
  description="Learn how Freedom Fridge & Pantry keeps Charlotte neighbors fed and how to support it."
  slug="freedom-fridge"
>
  <Header
    title="Freedom Fridge & Pantry"
    tagline="Free food, shared care."
    image={freedomFridgeImage}
    overlayClassName="bg-gradient-to-t from-black/80 via-black/55 to-black/35"
  />

  <div class="site-section space-y-20 text-center lg:space-y-28">
    <div class="reading-container space-y-6">
      <p class="max-w-4xl mx-auto">
        The Freedom Fridge and Pantry is a community resource open 24 hours a day at 2916 Parkway Avenue, just off Tuckaseegee Road. Located outdoors for easy access, it provides free food, meals, fresh refrigerated items, pantry staples, and hygiene supplies for anyone in need.
      </p>
      <p class="max-w-4xl mx-auto">
        Stocked by volunteers, the fridge and pantry are built on concepts of community care, dignity, and shared wellbeing. All items are supplied and available on a first-come, first-served basis—no sign-up or requirements needed.
      </p>
    </div>

    <section class="site-container space-y-8 border-y border-border py-12 text-center">
      <SectionHeading title="Ways To Help" />
      <div class="mx-auto grid max-w-4xl gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2">
        {waysToHelp.map((item, index) => (
          index === waysToHelp.length - 1 ? (
            <a href={donateLink} target="_blank" rel="noreferrer" class="bg-secondary p-6 text-left text-sm font-semibold text-secondary-foreground transition-colors hover:bg-secondary/80">
              <p>Make a <span class="underline">donation</span> to support free food access and community care.</p>
            </a>
          ) : (
            <article class="bg-background p-6 text-left text-sm">
              <p>{item}</p>
            </article>
          )
        ))}
      </div>
    </section>
    <p class="mx-auto max-w-3xl text-center text-sm text-muted-foreground">
      The pantry is one part of QC Family Tree’s broader mutual-aid work. <a href="/about#programs-about" class="text-primary underline hover:text-primary/80">Learn about our programs</a>, <a href="/#events" class="text-primary underline hover:text-primary/80">join a community event</a>, or <a href="/contact" class="text-primary underline hover:text-primary/80">contact us</a> to get involved.
    </p>
  </div>
</Layout>
