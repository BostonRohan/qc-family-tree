---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { Link } from "@/components/ui/link";
import { Image } from "astro:assets";
import Programs from "@/components/sections/Programs.astro";
import aboutBorder1 from "@/assets/about_border_1.jpeg";
import aboutBorder2 from "@/assets/about_border_2.jpeg";
import headerImage from "@/assets/about-option.jpg";
import { defineQuery } from "groq";
import { sanityClient } from "sanity:client";

type Report = { year: number; url: string };
type Accountability = {
  annualReports?: Report[];
  form990s?: Report[];
};

const ACCOUNTABILITY_QUERY = defineQuery(`
  *[_type == "accountability" && _id == "accountability"][0] {
    "annualReports": annualReports[] | order(year desc) { year, url },
    "form990s": form990s[] | order(year desc) { year, url }
  }
`);

const fallbackAccountability: Required<Accountability> = {
  annualReports: [
    { year: 2025, url: "https://drive.google.com/file/d/1IBK84-g3meMXCCtYt0trhv0DN1Ud2C0g/view?usp=sharing" },
    { year: 2024, url: "https://drive.google.com/file/d/1obkW2SGpPdGztWhuNIfRWrGKMsCNSD7e/view?ts=69dfb735" },
    { year: 2023, url: "https://drive.google.com/file/d/1dyT6Sn5XYs9uibEl5XQNaeutBs-xa7Ly/view?ts=69dfb756" },
  ],
  form990s: [
    { year: 2024, url: "https://projects.propublica.org/nonprofits/organizations/204091165/202503149349305480/full" },
    { year: 2023, url: "https://projects.propublica.org/nonprofits/organizations/204091165/202440729349301409/full" },
    { year: 2022, url: "https://projects.propublica.org/nonprofits/organizations/204091165/202313039349301436/full" },
  ],
};

const accountability =
  (await sanityClient.fetch<Accountability | null>(ACCOUNTABILITY_QUERY)) ??
  fallbackAccountability;

const values = [
  "We believe that our freedom is connected to the freedom of people who are struggling the most.",
  "We strive to prioritize the full liberation of Black people, believing that their liberation ushers in freedom for all.",
  "We practice collective action, accountability, anti-racism, decentralized wealth, and mutual aid.",
  "We commit to healing practices that sustain our work, knowing repair and reconciliation are part of the journey.",
  "We honor land, elders, and history, celebrating the assets, gifts, and resources of people and place.",
];

const cultivationPractices = [
  {
    title: "Demonstration",
    summary:
      "We embody what we believe through hallowed placemaking, affordable housing, and reciprocal campus care.",
  },
  {
    title: "Co-Creation & Honoring",
    summary:
      "Deep listening to land, history, and neighbors shows up through walkabouts, chicken care, and gardening.",
  },
  {
    title: "Cultural experiences and expressions",
    summary:
      "Art, food, music, and public installations become commons for storytelling, care, and resistance.",
  },
  {
    title: "Nourishing Interdependence",
    summary:
      "Trust, belonging, and fulfillment grow through mutual aid, free pantries, and shared community events.",
  },
  {
    title: "Organizing and Catalyzing",
    summary:
      "People power builds via mutual aid, advocacy, and coalitions like WSCLT, ROOTS, and the Southern Movement Assembly.",
  },
  {
    title: "Prophetic Imagination & Intentionality",
    summary:
      "Storytelling, strategic communication, and disciplined study chart new possibilities while staying rooted in truth.",
  },
  {
    title: "Public Witness",
    summary:
      "Solidarity actions, political education, and public presentations declare our commitments in the shared sphere.",
  },
];




---

<Layout
  title="About QC Family Tree"
  description="Learn about QCFT's mission, theory of change, values, and long-term goals."
  slug="about"
>
  <div>
    <Header
      title="About QC Family Tree"
      subline="Rooted in belonging, mutual care, and economic resilience."
      image={headerImage}
      imageAlt="Oak tree canopy framing the sky"
      imageClassName="!object-center"
      overlayClassName="bg-gradient-to-b from-black/70 via-black/55 to-black/65"
    />
  </div>
  <div class="site-section space-y-16 lg:space-y-24">
    <section id="mission" class="site-container space-y-8">
      <div class="reading-container space-y-5 text-center">
      <p>
        QC Family Tree is a community-rooted non-profit organization cultivating spaces of belonging, mutual care, and economic resilience by supporting local creatives, entrepreneurs, and neighbors. Our work building a more just and connected Charlotte is guided by resilience, adaptability, and a commitment to racial and gender equity.
      </p>
      <p class="text-sm text-muted-foreground">
        <span class="text-secondary font-semibold">Mission:</span> Cultivate community for the common good.
        <br />
        <span class="text-accent font-semibold">Vision:</span> Thriving communities of abundance, justice, imagination, and mutual care for all.
      </p>
      </div>
      <SectionHeading title="Values" />
      <ol class="mx-auto grid max-w-5xl gap-x-10 sm:grid-cols-2">
        {values.map((value, index) => (
          <li class="flex gap-4 border-t border-border py-5 text-sm">
            <span class="font-ubuntu text-lg font-bold text-secondary">0{index + 1}</span>
            <p>{value}</p>
          </li>
        ))}
      </ol>
    </section>

    <Programs sectionId="programs-about" showLearnMore={false} dividerSrc={aboutBorder1.src} />

    <section class="site-container rounded-2xl bg-accent px-6 py-12 text-center text-accent-foreground sm:px-10">
      <h2 class="text-balance text-3xl sm:text-4xl">See the work in community</h2>
      <p class="mx-auto mt-3 max-w-2xl text-accent-foreground/80">
        From free food access to artist support and neighborhood events, our programs turn this vision into practice.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <Link href="/freedom-fridge" variant="secondary" className="rounded-xl px-5 py-3 text-sm">Visit the Freedom Fridge</Link>
        <Link href="/#events" variant="outline" className="rounded-xl border-white/50 px-5 py-3 text-sm text-white hover:bg-white hover:text-accent">See upcoming events</Link>
      </div>
    </section>

    <section id="cultivation" class="site-container space-y-8">
      <SectionHeading title="How we cultivate the common good" />
      <div class="grid gap-3 sm:grid-cols-2">
        {cultivationPractices.map((practice) => (
          <div class="border-l-2 border-secondary bg-muted px-4 py-3 font-semibold">
            {practice.title}
          </div>
        ))}
      </div>
    </section>

    <div class="site-container aspect-[21/9] overflow-hidden rounded-2xl">
      <Image
        src={aboutBorder2}
        alt=""
        class="h-full w-full object-cover"
      />
    </div>

    <section id="sustainability" class="site-container space-y-8">
      <SectionHeading title="Sustainability & accountability" />
      <p>
        QC Family Tree is guided by a team of staff, board members, and community partners who are dedicated to the long-term wellbeing of West Charlotte. We are committed to being open, responsible, and accountable to our community.
      </p>
      <div class="space-y-6 pt-4">
        <div>
          <h3 class="font-semibold mb-2">Annual Reports</h3>
          <ul class="flex flex-wrap gap-3">
            {(accountability.annualReports ?? fallbackAccountability.annualReports).map((report) => (
              <li><a href={report.url} target="_blank" rel="noreferrer" class="text-primary underline">{report.year}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Form 990s</h3>
          <ul class="flex flex-wrap gap-3">
            {(accountability.form990s ?? fallbackAccountability.form990s).map((report) => (
              <li><a href={report.url} target="_blank" rel="noreferrer" class="text-primary underline">{report.year}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>
