---
import Welcome from "@/components/sections/Welcome.astro";
import Contact from "@/components/sections/Contact.astro";
import Layout from "@/layouts/Layout.astro";
import Programs from "@/components/sections/Programs.astro";
import Featured from "@/components/sections/Featured.astro";
import Events from "@/components/sections/events/index.astro";
import Vision from "@/components/sections/Vision.astro";
import { defineQuery } from "groq";
import { sanityClient } from "sanity:client";
import type { FeaturedSection, Hero } from "sanity.types";

const HOME_PAGE_QUERY = defineQuery(`
{
  hero: *[_type == "hero" && showHero == true] | order(_updatedAt desc)[0] {
    descriptor,
    primaryCtaLabel,
    primaryCtaLink,
    secondaryCtaLabel,
    secondaryCtaLink
  },
  featuredSection: *[_type == "featuredSection"][0] {
    _id,
    title,
    description,
    primaryCtaLink,
    primaryCtaLabel,
    secondaryCtaLabel,
    secondaryCtaLink,
    image {
      asset->{_ref}
    }
  }
}
`);

const homepageData = await sanityClient.fetch<{
  hero?: Hero | null;
  featuredSection?: FeaturedSection | null;
}>(HOME_PAGE_QUERY);

const hero = homepageData?.hero ?? null;
const featuredSection = homepageData?.featuredSection ?? null;
---

<Layout
  description="A neighborhood-based community development org working at the intersection of faith, culture, and social change."
  slug=""
  title="QC Family Tree"
>
  <div class="space-y-24 pb-24">
    <Welcome hero={hero} />
    <div class="space-y-4">
      <Vision />
      <Events maxDays={7} />
    </div>
    <Programs />
  </div>
  <Featured section={featuredSection} />
  <Contact />
</Layout>
